          "name": "Login Administrador (guarda el token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 200', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('token', pm.response.json().token); pm.collectionVariables.set('tokenRenovacion', pm.response.json().tokenRenovacion); pm.test('Rol Administrador', () => pm.expect(pm.response.json().usuario.rol).to.eql('Administrador'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "Inicia sesión como administrador. El token queda guardado en la variable {{token}} y se usa en las demás peticiones.",
